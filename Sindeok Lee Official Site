      font-size: 20px;
      text-decoration: none;
      transition: color 0.3s;
    }
    .social-links a:hover {
      color: var(--accent-color);
    }
    .language-selector {
      position: absolute;
      top: 20px;
      right: 20px;
    }
    .language-selector select {
      background-color: var(--nav-bg);
      color: var(--text-color);
      border: none;
      padding: 5px 10px;
      border-radius: 4px;
    }
    nav {
